{
    "name": "@nexus/email",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "import": "./src/index.ts",
            "default": "./src/index.ts"
        },
        "./templates": {
            "types": "./src/templates/index.ts",
            "import": "./src/templates/index.ts",
            "default": "./src/templates/index.ts"
        },
        "./testing": {
            "types": "./src/testing.ts",
            "import": "./src/testing.ts",
            "default": "./src/testing.ts"
        }
    },
    "scripts": {
        "test": "vitest",
        "test:run": "vitest run",
        "test:coverage": "vitest run --coverage",
        "typecheck": "tsc --noEmit",
        "lint": "eslint src/"
    },
    "dependencies": {
        "@react-email/components": "^1.0.12",
        "react": "19.2.3",
        "react-dom": "19.2.3",
        "resend": "^6.16.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.2",
        "@types/node": "^20",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "@vitest/coverage-v8": "^4.0.18",
        "eslint": "^9.39.2",
        "typescript": "^5",
        "typescript-eslint": "^8.67.0",
        "vitest": "^4.0.18"
    }
}
