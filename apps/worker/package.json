{
    "name": "@nexus/worker",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "tsup",
        "deploy:dev": "bash scripts/deploy.sh dev",
        "deploy:prod": "bash scripts/deploy.sh prod",
        "lint": "eslint .",
        "test": "vitest",
        "test:run": "vitest run",
        "test:coverage": "vitest run --coverage",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.975.0",
        "@aws-sdk/client-sqs": "^3.975.0",
        "@aws-sdk/s3-request-presigner": "^3.975.0",
        "@nexus/analytics": "workspace:*",
        "@nexus/async": "workspace:*",
        "@nexus/db": "workspace:*",
        "@nexus/email": "workspace:*",
        "drizzle-orm": "^0.45.1",
        "postgres": "^3.4.7",
        "react": "19.2.3",
        "yazl": "^3.3.1"
    },
    "devDependencies": {
        "@eslint/js": "^9.28.0",
        "@types/aws-lambda": "^8.10.149",
        "@types/node": "^20",
        "@types/react": "^19",
        "@types/yazl": "^3.3.1",
        "@vitest/coverage-v8": "^4.0.18",
        "eslint": "^9.28.0",
        "tsup": "^8.5.0",
        "typescript": "^5",
        "typescript-eslint": "^8.36.0",
        "vitest": "^4.0.18"
    }
}
