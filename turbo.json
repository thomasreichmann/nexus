{
    "$schema": "https://turbo.build/schema.json",
    "globalPassThroughEnv": ["*"],
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            "outputs": [".next/**", "dist/**"],
            "env": [
                "NEXT_PUBLIC_*",
                "!NEXT_PUBLIC_VERCEL_URL",
                "!NEXT_PUBLIC_VERCEL_BRANCH_URL",
                "!NEXT_PUBLIC_VERCEL_GIT_*",
                "!NEXT_PUBLIC_VERCEL_DEPLOYMENT_ID",
                "SENTRY_*"
            ]
        },
        "trpc-devtools#build": {
            "dependsOn": ["^build"],
            "outputs": ["dist/**"],
            "env": ["!NEXT_PUBLIC_*", "!VERCEL_DEPLOYMENT_ID"]
        },
        "dev": {
            "dependsOn": ["^build"],
            "cache": false,
            "persistent": true
        },
        "lint": {},
        "test": {},
        "test:coverage": {
            "outputs": ["coverage/**"]
        },
        "test:e2e": {
            "cache": false
        },
        "typecheck": {
            "dependsOn": ["^typecheck"]
        }
    }
}
